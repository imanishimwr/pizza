# Frontend environment. Copy to .env.local and fill in. Never commit real values.

# Where the REST API lives. (required)
# Local dev:   VITE_API_BASE_URL=http://localhost:5000/api
# Production:  VITE_API_BASE_URL=https://api.yourdomain.com/api
VITE_API_BASE_URL=

# Socket.IO server. Defaults to VITE_API_BASE_URL with /api stripped. (required)
# Local dev:   VITE_SOCKET_URL=http://localhost:5000
# Production:  VITE_SOCKET_URL=https://api.yourdomain.com
VITE_SOCKET_URL=

# Google Sign-In client id. Leave blank to hide the Google button entirely —
# the sign-in screen then only offers email + password.
VITE_GOOGLE_CLIENT_ID=
