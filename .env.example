# Frontend environment. Copy to .env.local and fill in. Never commit real values.

# Where the REST API lives.
VITE_API_BASE_URL=http://localhost:5002/api

# Socket.IO server. Defaults to VITE_API_BASE_URL with /api stripped.
VITE_SOCKET_URL=http://localhost:5002

# Origins allowed to call the API. Comma separated. Must include this dev origin.
VITE_ALLOWED_ORIGINS=http://localhost:3000

# Google Sign-In client id. Leave blank to hide the Google button entirely —
# the sign-in screen then only offers email + password.
VITE_GOOGLE_CLIENT_ID=
