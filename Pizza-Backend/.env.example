# Copy to .env and fill in. Never commit the real .env.

# Neon Postgres connection string (required)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Token signing key. Must be at least 32 characters. (required)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of browser origins allowed to call this API (required)
# Local dev:      CLIENT_ORIGIN=http://localhost:3000
# Production:     CLIENT_ORIGIN=https://yourdomain.com
CLIENT_ORIGIN=

# Google Sign-In (optional — the route returns 503 if this is unset)
GOOGLE_CLIENT_ID=

# Optional
PORT=5000
NODE_ENV=development
RATE_LIMIT_READ=20000
RATE_LIMIT_WRITE=600
