# Copy to .env and fill in. Never commit the real .env.

# Neon Postgres connection string (required)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Token signing key. Must be at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of browser origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Google Sign-In (optional — the route returns 503 if this is unset)
GOOGLE_CLIENT_ID=

# Staff accounts created by `npm run seed`
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
KITCHEN_NAME=
KITCHEN_EMAIL=
KITCHEN_PASSWORD=
DELIVERY_NAME=
DELIVERY_EMAIL=
DELIVERY_PASSWORD=

# Optional
PORT=5002
NODE_ENV=development
RATE_LIMIT_READ=20000
RATE_LIMIT_WRITE=600
